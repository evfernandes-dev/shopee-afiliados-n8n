# ============================================================
# Exemplo de variáveis de ambiente - Shopee Afiliados (n8n)
# ------------------------------------------------------------
# ESTE ARQUIVO NÃO CONTÉM NENHUM VALOR REAL.
# Copie para ".env" (que é ignorado pelo Git) e preencha locally.
#
# IMPORTANTE: o workflow publicado neste repositório usa
# placeholders no lugar destes valores. Veja o README.md,
# seção "Configuração", antes de importar o workflow.
# ============================================================

# Credenciais da sua aplicação no painel de afiliados da Shopee.
# Usadas no nó "PREP 1 - Montar request Shopee" para assinar a
# requisição à API (appId + timestamp + payload + appSecret).
SHOPEE_APP_ID=SEU_APP_ID_AQUI
SHOPEE_APP_SECRET=SEU_APP_SECRET_AQUI

# ID do chat/canal do Telegram que recebe as ofertas e os alertas.
# Não é o token do bot: o token fica cadastrado como credencial
# "Telegram API" dentro do próprio n8n (nunca em arquivo).
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI
